<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local Atlas development feed (uncomment when testing unpublished
         Atlas packages; points at the Atlas repository's artifacts/packages):
    <add key="atlas-local" value="../../Atlas/artifacts/packages" />
    -->
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
